# Optional protection for /api/v1/* routes. Keep this value private.
SECUREXAI_API_KEY=replace-with-a-local-api-key

# Optional Layer 3 Gemini candidate generation.
GEMINI_API_KEY=replace-with-google-ai-studio-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
SECUREXAI_ML_REENTRANCY_THRESHOLD=0.30
