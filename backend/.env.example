# Gemini provider through the native Google API.
OPENAI_API_KEY=replace-with-gemini-api-key
OPENAI_MODEL=gemini-2.5-flash
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
SECUREXAI_AI_REPAIR_TIMEOUT_SECONDS=300

# Optional protection for /api/v1/* routes. Keep this value private.
SECUREXAI_API_KEY=replace-with-a-local-api-key
